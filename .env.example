# ── API auth (the caller presents this on POST /calls) ───────────────────────
# Required. >=16 chars, not a placeholder. Generate: openssl rand -hex 24
API_TOKEN=

# ── Destination cost control ─────────────────────────────────────────────────
# Required. Comma-separated E.164 prefixes that may be dialled. Fails closed:
# empty = every call rejected. E.164 alone does not stop toll fraud (premium and
# satellite ranges are valid E.164), so keep this as tight as your real numbers.
#   e.g. ALLOWED_PREFIXES=+90,+1
ALLOWED_PREFIXES=
MAX_CONCURRENT_CALLS=30
MAX_REQUEST_BYTES=262144

# ── ARI (voice-api -> Asterisk, localhost only) ──────────────────────────────
ARI_USERNAME=callu
# Required. >=12 chars, not a placeholder.
ARI_PASSWORD=

# ── SIP trunk ────────────────────────────────────────────────────────────────
# There is no carrier setting here, and that is deliberate. The container starts without
# one and Callu supplies it: add the SIP trunk under Settings -> Communications, pick it on
# the callu-voice provider, and Callu pushes it over PUT /trunk. It keeps checking, so a
# restart or an image bump gets the carrier back without anyone doing anything.
# To run with no carrier at all, use the test endpoint / test callee below.
#
# How a number becomes a channel. The endpoint name after "@" is also what /health watches;
# a format with no "@" watches nothing.
ENDPOINT_FORMAT=PJSIP/%s@trunk

# ── NAT ──────────────────────────────────────────────────────────────────────
# Required when Asterisk is behind NAT (bridged Docker on Windows/macOS, cloud
# VMs). Without it the call connects with no audio. Use the address the carrier
# actually reaches.
EXTERNAL_MEDIA_ADDRESS=
EXTERNAL_SIGNALING_ADDRESS=

# ── Media ────────────────────────────────────────────────────────────────────
SIP_PORT=5060
RTP_START=10000
RTP_END=10099

# ── Call flow ────────────────────────────────────────────────────────────────
DETECT_MACHINE=false
MAX_CALL_DURATION=120s
SILENCE_TIMEOUT=15s
MAX_REPROMPTS=2
DIAL_TIMEOUT=45s

# ── Resources ────────────────────────────────────────────────────────────────
MEM_LIMIT=3g
# Cores the synthesizer may use. Blank = all but two.
TTS_THREADS=

# ── Development only ─────────────────────────────────────────────────────────
# Registers softphone 6001 and enables the test-callee dialplan.
TEST_ENDPOINTS=false
TEST_PASSWORD=
